{
  "title": "Deterministic raw FactExtractionAgent result",
  "description": "Untrusted raw Agent output before Harness provenance, position and protection enrichment.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result"
  ],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.2.1"] },
    "result": {
      "anyOf": [
        { "$ref": "#/$defs/ok_result" },
        { "$ref": "#/$defs/scope_too_large_result" }
      ]
    }
  },
  "$defs": {
    "ok_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_status",
        "scope_error",
        "source_role_candidates",
        "evidence",
        "facts",
        "bill_identities",
        "bill_relations",
        "legislative_events",
        "provision_comparisons",
        "supplementary_rules"
      ],
      "properties": {
        "result_status": { "type": "string", "enum": ["OK"] },
        "scope_error": { "type": "null" },
        "source_role_candidates": { "$ref": "#/$defs/source_role_candidates_array" },
        "evidence": { "$ref": "#/$defs/evidence_array" },
        "facts": { "$ref": "#/$defs/facts_array" },
        "bill_identities": { "$ref": "#/$defs/bill_identities_array" },
        "bill_relations": { "$ref": "#/$defs/bill_relations_array" },
        "legislative_events": { "$ref": "#/$defs/legislative_events_array" },
        "provision_comparisons": { "$ref": "#/$defs/provision_comparisons_array" },
        "supplementary_rules": { "$ref": "#/$defs/supplementary_rules_array" }
      }
    },
    "scope_too_large_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_status",
        "scope_error",
        "source_role_candidates",
        "evidence",
        "facts",
        "bill_identities",
        "bill_relations",
        "legislative_events",
        "provision_comparisons",
        "supplementary_rules"
      ],
      "properties": {
        "result_status": { "type": "string", "enum": ["FACT_SCOPE_TOO_LARGE"] },
        "scope_error": { "$ref": "#/$defs/scope_error" },
        "source_role_candidates": { "$ref": "#/$defs/empty_source_role_candidates_array" },
        "evidence": { "$ref": "#/$defs/empty_evidence_array" },
        "facts": { "$ref": "#/$defs/empty_facts_array" },
        "bill_identities": { "$ref": "#/$defs/empty_bill_identities_array" },
        "bill_relations": { "$ref": "#/$defs/empty_bill_relations_array" },
        "legislative_events": { "$ref": "#/$defs/empty_legislative_events_array" },
        "provision_comparisons": { "$ref": "#/$defs/empty_provision_comparisons_array" },
        "supplementary_rules": { "$ref": "#/$defs/empty_supplementary_rules_array" }
      }
    },
    "source_role_candidates_array": {
      "type": "array",
      "maxItems": 18,
      "items": { "$ref": "#/$defs/source_role_candidate" }
    },
    "evidence_array": {
      "type": "array",
      "maxItems": 40,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "facts_array": {
      "type": "array",
      "maxItems": 30,
      "items": { "$ref": "#/$defs/fact" }
    },
    "bill_identities_array": {
      "type": "array",
      "maxItems": 2,
      "items": { "$ref": "#/$defs/bill_identity" }
    },
    "bill_relations_array": {
      "type": "array",
      "maxItems": 1,
      "items": { "$ref": "#/$defs/bill_relation" }
    },
    "legislative_events_array": {
      "type": "array",
      "maxItems": 6,
      "items": { "$ref": "#/$defs/legislative_event" }
    },
    "provision_comparisons_array": {
      "type": "array",
      "maxItems": 3,
      "items": { "$ref": "#/$defs/provision_comparison" }
    },
    "supplementary_rules_array": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/supplementary_rule" }
    },
    "empty_source_role_candidates_array": {
      "type": "array",
      "maxItems": 0,
      "items": { "$ref": "#/$defs/source_role_candidate" }
    },
    "empty_evidence_array": {
      "type": "array",
      "maxItems": 0,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "empty_facts_array": {
      "type": "array",
      "maxItems": 0,
      "items": { "$ref": "#/$defs/fact" }
    },
    "empty_bill_identities_array": {
      "type": "array",
      "maxItems": 0,
      "items": { "$ref": "#/$defs/bill_identity" }
    },
    "empty_bill_relations_array": {
      "type": "array",
      "maxItems": 0,
      "items": { "$ref": "#/$defs/bill_relation" }
    },
    "empty_legislative_events_array": {
      "type": "array",
      "maxItems": 0,
      "items": { "$ref": "#/$defs/legislative_event" }
    },
    "empty_provision_comparisons_array": {
      "type": "array",
      "maxItems": 0,
      "items": { "$ref": "#/$defs/provision_comparison" }
    },
    "empty_supplementary_rules_array": {
      "type": "array",
      "maxItems": 0,
      "items": { "$ref": "#/$defs/supplementary_rule" }
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "evidence_quote": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "id_list": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/id" }
    },
    "fact_value": {
      "anyOf": [
        { "$ref": "#/$defs/text" },
        { "type": "number" },
        { "type": "boolean" },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "anyOf": [
              { "$ref": "#/$defs/text" },
              { "type": "number" },
              { "type": "boolean" }
            ]
          }
        }
      ]
    },
    "scope_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "reason"],
      "properties": {
        "subject": { "$ref": "#/$defs/text" },
        "reason": { "$ref": "#/$defs/text" }
      }
    },
    "source_role_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "source_id", "role", "label", "evidence_ids"],
      "properties": {
        "candidate_id": { "$ref": "#/$defs/id" },
        "source_id": { "$ref": "#/$defs/id" },
        "role": {
          "enum": [
            "의안정보",
            "현행 조문",
            "발의안",
            "본회의 상정안",
            "위원회 최종문",
            "본회의 표결 결과",
            "본회의 최종문",
            "대안 관계",
            "공포 개정문",
            "부칙",
            "공식 제안·개정이유",
            "공식 발언문"
          ]
        },
        "label": { "$ref": "#/$defs/text" },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "source_id", "quote"],
      "properties": {
        "evidence_id": { "$ref": "#/$defs/id" },
        "source_id": { "$ref": "#/$defs/id" },
        "quote": { "$ref": "#/$defs/evidence_quote" }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_id", "kind", "value", "source_id", "evidence_id", "valid_source_role_candidate_ids"],
      "properties": {
        "fact_id": { "$ref": "#/$defs/id" },
        "kind": { "$ref": "#/$defs/text" },
        "value": { "$ref": "#/$defs/fact_value" },
        "source_id": { "$ref": "#/$defs/id" },
        "evidence_id": { "$ref": "#/$defs/id" },
        "valid_source_role_candidate_ids": {
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "bill_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bill_id", "bill_number", "is_draft_subject", "source_id", "evidence_ids"],
      "properties": {
        "bill_id": { "$ref": "#/$defs/id" },
        "bill_number": { "$ref": "#/$defs/text" },
        "is_draft_subject": { "type": "boolean" },
        "source_id": { "$ref": "#/$defs/id" },
        "evidence_ids": { "$ref": "#/$defs/id_list" }
      }
    },
    "bill_relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin_bill_id", "alternative_bill_id", "relation_type", "source_id", "evidence_ids"],
      "properties": {
        "origin_bill_id": { "$ref": "#/$defs/id" },
        "alternative_bill_id": { "$ref": "#/$defs/id" },
        "relation_type": { "$ref": "#/$defs/text" },
        "source_id": { "$ref": "#/$defs/id" },
        "evidence_ids": { "$ref": "#/$defs/id_list" }
      }
    },
    "legislative_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "bill_id", "procedure_stage", "disposition", "occurred_on", "source_id", "evidence_id", "valid_source_role_candidate_ids"],
      "properties": {
        "event_id": { "$ref": "#/$defs/id" },
        "bill_id": { "$ref": "#/$defs/id" },
        "procedure_stage": { "$ref": "#/$defs/text" },
        "disposition": { "$ref": "#/$defs/text" },
        "occurred_on": { "type": "string", "format": "date", "maxLength": 10 },
        "source_id": { "$ref": "#/$defs/id" },
        "evidence_id": { "$ref": "#/$defs/id" },
        "valid_source_role_candidate_ids": {
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "provision_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparison_id", "provision_id", "current_source_id", "current_evidence_id", "final_source_id", "final_evidence_id"],
      "properties": {
        "comparison_id": { "$ref": "#/$defs/id" },
        "provision_id": { "$ref": "#/$defs/text" },
        "current_source_id": { "$ref": "#/$defs/id" },
        "current_evidence_id": { "$ref": "#/$defs/id" },
        "final_source_id": { "$ref": "#/$defs/id" },
        "final_evidence_id": { "$ref": "#/$defs/id" }
      }
    },
    "supplementary_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "kind", "applies_to", "source_id", "evidence_id", "valid_source_role_candidate_ids"],
      "properties": {
        "rule_id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["EFFECTIVE_DATE", "PROVISION_EFFECTIVE_DATE", "APPLICATION", "TRANSITION", "SPECIAL_CASE"] },
        "applies_to": { "$ref": "#/$defs/text" },
        "source_id": { "$ref": "#/$defs/id" },
        "evidence_id": { "$ref": "#/$defs/id" },
        "valid_source_role_candidate_ids": {
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    }
  }
}
