{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/assembly-press-draft-candidate.schema.json",
  "title": "Deterministic DraftWritingAgent candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "version",
    "procedure_stage",
    "effect_status",
    "basis_date",
    "announcement_subject_fact_id",
    "announcement_subject_provenance",
    "release_date_status",
    "release_date_fact_id",
    "draft_label",
    "title",
    "key_points",
    "lead",
    "paragraphs",
    "contact_status",
    "contact_text",
    "quote",
    "attachments",
    "six_w_status",
    "claims",
    "validation_finding_ids",
    "placeholders",
    "generated_at",
    "next_procedure_fact_ids"
  ],
  "properties": {
    "schema_version": { "const": "1.1.0" },
    "candidate_id": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "procedure_stage": { "const": "PLENARY_DECIDED" },
    "effect_status": { "const": "NOT_A_LAW" },
    "basis_date": { "type": "string", "format": "date" },
    "announcement_subject_fact_id": { "type": "string" },
    "announcement_subject_provenance": { "enum": ["USER_CONFIRMED", "OFFICIAL_SOURCE", "APPROVED_PROFILE"] },
    "release_date_status": { "type": "string" },
    "release_date_fact_id": { "type": "string" },
    "draft_label": { "type": "string" },
    "title": { "$ref": "#/$defs/claim_text" },
    "key_points": { "type": "array", "minItems": 2, "maxItems": 3, "items": { "$ref": "#/$defs/claim_text" } },
    "lead": { "$ref": "#/$defs/claim_text" },
    "paragraphs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["paragraph_id", "section_kind", "priority_rank", "text", "claim_ids", "fact_ids", "supplementary_rule_ids"],
        "properties": {
          "paragraph_id": { "type": "string" },
          "section_kind": { "type": "string" },
          "priority_rank": { "type": "integer", "minimum": 1 },
          "text": { "type": "string" },
          "claim_ids": { "type": "array", "items": { "type": "string" } },
          "fact_ids": { "type": "array", "items": { "type": "string" } },
          "supplementary_rule_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "contact_status": { "type": "string" },
    "contact_text": { "type": "string" },
    "quote": { "type": ["object", "null"] },
    "attachments": { "type": "array" },
    "six_w_status": { "type": "object" },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "text", "fact_ids"],
        "properties": {
          "claim_id": { "type": "string" },
          "text": { "type": "string" },
          "fact_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "validation_finding_ids": { "type": "array", "items": { "type": "string" } },
    "placeholders": { "type": "array", "items": { "type": "string" } },
    "generated_at": { "type": "string" },
    "next_procedure_fact_ids": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "claim_text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "claim_ids", "fact_ids"],
      "properties": {
        "text": { "type": "string" },
        "claim_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "fact_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    }
  }
}
