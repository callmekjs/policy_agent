{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/assembly-press-mutation.schema.json",
  "title": "Single-risk fixture mutation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "mutation_id",
    "risk_code",
    "target_type",
    "target_id",
    "operation",
    "selector"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.1.0" },
    "mutation_id": { "type": "string" },
    "risk_code": { "type": "string" },
    "target_type": {
      "enum": ["SOURCE_TEXT", "SOURCE_ROLE", "DRAFT_CANDIDATE", "REVISION_REQUEST"]
    },
    "target_id": { "type": "string" },
    "operation": {
      "enum": ["REPLACE_TEXT", "REPLACE_ROLE", "REMOVE_JSON_VALUE", "REPLACE_JSON_VALUE", "ADD_TEXT", "REQUEST_INSTRUCTION", "PATCH_JSON"]
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "exact_text": { "type": "string" },
        "json_pointer": { "type": "string" }
      }
    },
    "replacement": {},
    "patches": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["op", "json_pointer"],
        "properties": {
          "op": { "enum": ["add", "remove", "replace"] },
          "json_pointer": { "type": "string", "pattern": "^/" },
          "value": {}
        }
      }
    }
  }
}
